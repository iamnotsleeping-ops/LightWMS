node_modules/
dist/
coverage/

# pnpm 项目本地存储（store-dir 指向仓库内时产生）
.pnpm-store/
.npm-cache/

# 本地数据库
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 环境变量与部署时的 .env 备份
# 备份文件同样含 JWT_SECRET / 钉钉密钥，必须一并忽略：
# 部署脚本会在服务器仓库目录里生成 .env.bak-<时间戳>，若未忽略，
# 一旦有人在服务器上执行 `git add -A` 就会把生产密钥提交进公开仓库。
.env
.env.bak*
.env.*.bak

# 编辑器与系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log