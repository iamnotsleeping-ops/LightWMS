# 复制为 .env 后按需修改
NODE_ENV=development
# 默认 3100：3000 常被其他桌面应用（如 Xmind）占用
PORT=3100
HOST=0.0.0.0
# 留空则使用 packages/server/data/erp.db
DB_PATH=

# ---- 认证 ----
# 本地开发填 mock（假用户，无需钉钉环境）；部署到服务器联调/生产填 dingtalk
AUTH_PROVIDER=mock
JWT_SECRET=dev-secret-change-me
# 有效期 8h，不做 refresh / 登出黑名单
JWT_EXPIRES_IN=8h

# ---- 钉钉 SSO（AUTH_PROVIDER=dingtalk 时必填）----
# 扫码登录仅需 APP_KEY + APP_SECRET（CORP_ID / AGENT_ID 预留给后续免登扩展，可暂不填）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
# 扫码登录回调地址，须与开放平台「登录与分享-回调域名」完全一致
DINGTALK_REDIRECT_URI=

# ---- 登录成功后前端回跳地址 ----
# 留空则自动取 DINGTALK_REDIRECT_URI 的 origin，再退化为 http://localhost:5173
WEB_ORIGIN=

# ---- 系统参数默认值（可在「系统参数」页覆盖）----
# 港口仓库存是否计入库存口径，默认 false
PORT_STOCK_AS_INVENTORY=false