# 复制为 .env 后按需修改
NODE_ENV=development
# 默认 3100：3000 常被其他桌面应用（如 Xmind）占用
PORT=3100
HOST=0.0.0.0
# 留空则使用 packages/server/data/erp.db
DB_PATH=

# ---- 认证 ----
# 本地开发填 mock（假用户，无需钉钉环境）；部署到服务器联调/生产填 dingtalk
#
# ⚠ NODE_ENV=production 时后端会在启动前自检并拒绝启动，若出现以下任一情况：
#     · AUTH_PROVIDER 仍为 mock（该通道允许任意姓名自助登录并自动获得 sys_admin）
#     · JWT_SECRET 仍为下方的默认值（泄漏即可伪造任意用户令牌）
#     · AUTH_PROVIDER=dingtalk 但 APP_KEY / APP_SECRET / REDIRECT_URI 有空缺
#   开发环境不做此限制。
AUTH_PROVIDER=mock
# 生产环境请改为随机长字符串：openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
# 有效期 8h，不做 refresh / 登出黑名单
JWT_EXPIRES_IN=8h
# 逃生开关（默认 false，保持关闭）：仅当确实要在「可信网络内」以 mock 通道跑生产时
# 才设为 true。**生产环境同时必须把 MOCK_AUTO_ADMIN 设为 false**，否则自检仍拒绝启动。
ALLOW_INSECURE_AUTH=false
# mock 通道是否允许「自助建号 + 自动授予 sys_admin」，默认 true（保留本地开发便利）。
# 生产上用 mock 时必须设为 false：mock 登录只允许**已存在**的账号，不再建号、不再补授角色。
# 注意 mock 的凭据就是账号名本身——设为 false 之后仍须保证既有账号名不可猜
# （建议用随机长串，例如 运维入口-9f3a7c），否则知道名字的人就能登录为该账号。
MOCK_AUTO_ADMIN=true

# ---- 钉钉 SSO（AUTH_PROVIDER=dingtalk 时必填）----
# 扫码登录仅需 APP_KEY + APP_SECRET（CORP_ID / AGENT_ID 预留给后续免登扩展，可暂不填）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
# 扫码登录回调地址，须与开放平台「登录与分享-回调域名」完全一致
DINGTALK_REDIRECT_URI=

# ---- 登录成功后前端回跳地址 ----
# 留空则自动取 DINGTALK_REDIRECT_URI 的 origin，再退化为 http://localhost:5173
WEB_ORIGIN=

# ---- 系统参数默认值（可在「系统参数」页覆盖）----
# 港口仓库存是否计入库存口径，默认 false
PORT_STOCK_AS_INVENTORY=false